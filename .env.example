# ===== MRAZ Master environment =====
# Copy this file to .env and adjust as needed.

# Django
# Only enable HTTPS with a trusted TLS proxy and a publicly reachable HTTPS GM endpoint.
DJANGO_HTTPS_ENABLED=False
TRUST_PROXY_SSL_HEADER=False
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
GM_SESSION_AGE_SECONDS=43200
# Per username+IP lockouts (django-axes, backed by PostgreSQL).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=mraz.local,127.0.0.100,localhost
CSRF_TRUSTED_ORIGINS=http://mraz.local

# Optional public HUMAN-player endpoint through Cloudflare Tunnel.
# Bare hostname only, no https://, port, or path.
PUBLIC_PLAYER_HOST=
# Secret token of a remotely-managed Cloudflare Tunnel. Never commit the real value.
CLOUDFLARE_TUNNEL_TOKEN=

# Database (PostgreSQL)
POSTGRES_DB=mraz
POSTGRES_USER=mraz
POSTGRES_PASSWORD=changeme_pg_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# LLM backend: "mock" or "litellm"
LLM_BACKEND=mock

# Context manager budgets. Approximate character budgets; <= 0 means unlimited.
CONTEXT_HISTORY_MAX_CHARS=40000
CONTEXT_LORE_MAX_CHARS=50000

# LiteLLM Proxy
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-default

# Host Ollama (for LiteLLM container)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- External provider API keys (optional, only if using real models) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Per scene-specific bearer token. GET status/fragment polling is not throttled.
PLAYER_TURN_LIMIT=12
PLAYER_OOC_LIMIT=10
PLAYER_APPEARANCE_LIMIT=20
PLAYER_UPLOAD_LIMIT=3
PLAYER_QR_LIMIT=30
