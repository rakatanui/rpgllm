# ===== MRAZ Master environment =====
# Copy this file to .env and adjust as needed.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=mraz.local,127.0.0.100,localhost
CSRF_TRUSTED_ORIGINS=http://mraz.local

# Database (PostgreSQL)
POSTGRES_DB=mraz
POSTGRES_USER=mraz
POSTGRES_PASSWORD=changeme_pg_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# LLM backend: "mock" or "litellm"
LLM_BACKEND=mock

# Context manager budgets. Approximate character budgets; <= 0 means unlimited.
CONTEXT_HISTORY_MAX_CHARS=40000
CONTEXT_LORE_MAX_CHARS=50000

# LiteLLM Proxy
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-default

# Host Ollama (for LiteLLM container)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- External provider API keys (optional, only if using real models) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=